{
  "name": "@tomato/grid",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "clsx": "^2.1.1",
    "fractional-indexing": "^3.2.0",
    "re-resizable": "^6.11.2",
    "remeda": "^2.39.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@tomato/eslint-config": "workspace:*",
    "@tomato/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
