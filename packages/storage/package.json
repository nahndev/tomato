    "@tomato/eslint-config": "workspace:*",
    "@tomato/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
