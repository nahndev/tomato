{
  "name": "@tomato/events",
  "version": "0.4.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^12.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@tomato/eslint-config": "workspace:*",
    "@tomato/tsconfig": "workspace:*",
    "eslint": "^10.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
