{
  "name": "tomato",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate": "pnpm --filter @tomato/api generate",
    "migrate": "pnpm --filter @tomato/api migrate"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  }
}
