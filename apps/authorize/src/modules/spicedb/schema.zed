definition user {
  relation department: department
  relation all: user

  relation creator: role
  relation reader: role
  relation updater: role
  relation remover: role

  permission can_create = creator->has_member + all->can_create
  permission can_read = reader->has_member + all->can_read
  permission can_update = updater->has_member + all->can_update
  permission can_delete = remover->has_member + all->can_delete
}

definition department {
  relation member: user
  relation role: role
}

definition role {
  relation department: department
  relation member: user

  permission has_member = member
}

definition document {
  relation department: department
  relation owner: user
  relation all: document

  relation creator: role
  relation reader: role
  relation updater: role
  relation remover: role

  permission view = owner + department->member
  permission edit = owner

  permission can_create = creator->has_member + all->can_create
  permission can_read = reader->has_member + all->can_read
  permission can_update = updater->has_member + all->can_update
  permission can_delete = remover->has_member + all->can_delete
}
