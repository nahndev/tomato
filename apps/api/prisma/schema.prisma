generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  previewImageUrl String?           @map("preview_image_url")
  categoryId      String            @map("category_id") @db.Uuid
  category        TemplateCategory  @relation(fields: [categoryId], references: [id])
  versions        TemplateVersion[]
  boards          BoardTemplate[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("templates")
}

model TemplateCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  color     String
  isDefault Boolean    @default(false) @map("is_default")
  templates Template[]

  @@map("template_categories")
}

model TemplateVersion {
  id          String       @id @default(uuid()) @db.Uuid
  templateId  String       @map("template_id") @db.Uuid
  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  snapshot    Json
  createdAt   DateTime     @default(now()) @map("created_at")
  submissions Submission[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

model Board {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  columns     Json            @default("[]")
  templates   BoardTemplate[]
  submissions Submission[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("boards")
}

model BoardTemplate {
  boardId    String   @map("board_id") @db.Uuid
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateId String   @map("template_id") @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([boardId, templateId])
  @@index([templateId])
  @@map("board_templates")
}

model Submission {
  id                String          @id @default(uuid()) @db.Uuid
  boardId           String          @map("board_id") @db.Uuid
  board             Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateVersionId String          @map("template_version_id") @db.Uuid
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  data              Json            @default("{}")
  dataClocks        Json            @default("{}") @map("data_clocks")
  dataDisplays      Json            @default("{}") @map("data_displays")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([boardId])
  @@index([templateVersionId])
  @@map("submissions")
}

model UnitType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isDefault Boolean  @default(false) @map("is_default")
  units     Unit[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unit_types")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  typeId    String   @map("type_id") @db.Uuid
  type      UnitType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([typeId])
  @@map("units")
}
