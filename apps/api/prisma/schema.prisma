generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id              String            @id @default(uuid(7)) @db.Uuid
  name            String
  description     String?
  previewImageUrl String?           @map("preview_image_url")
  categoryId      String            @map("category_id") @db.Uuid
  category        TemplateCategory  @relation(fields: [categoryId], references: [id])
  versions        TemplateVersion[]
  boards          BoardTemplate[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("templates")
}

model TemplateCategory {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @unique
  color     String
  isDefault Boolean    @default(false) @map("is_default")
  templates Template[]

  @@map("template_categories")
}

model TemplateVersion {
  id          String       @id @default(uuid(7)) @db.Uuid
  templateId  String       @map("template_id") @db.Uuid
  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     String
  snapshot    Json
  createdAt   DateTime     @default(now()) @map("created_at")
  submissions Submission[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

model Board {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  columns     Json            @default("[]")
  templates   BoardTemplate[]
  submissions Submission[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("boards")
}

model BoardTemplate {
  boardId    String   @map("board_id") @db.Uuid
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateId String   @map("template_id") @db.Uuid
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([boardId, templateId])
  @@index([templateId])
  @@map("board_templates")
}

model Submission {
  id                String          @id @default(uuid(7)) @db.Uuid
  boardId           String          @map("board_id") @db.Uuid
  board             Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateVersionId String          @map("template_version_id") @db.Uuid
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  data              Json            @default("{}")
  dataClocks        Json            @default("{}") @map("data_clocks")
  dataDisplays      Json            @default("{}") @map("data_displays")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([boardId])
  @@index([templateVersionId])
  @@map("submissions")
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  email        String     @unique
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("users")
}

model DebeziumSignal {
  id   String  @id @db.VarChar(42)
  type String  @db.VarChar(32)
  data String? @db.VarChar(2048)

  @@map("debezium_signal")
}
